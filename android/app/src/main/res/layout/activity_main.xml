<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/not_connected"
        android:textSize="14sp" />

    <com.ismi9.vdsscope.ScopeView
        android:id="@+id/scopeView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0a0f0a" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/cbCh1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ch1"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbCh2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ch2"
            android:checked="true" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <Spinner
            android:id="@+id/spVolt1"
            android:layout_width="90dp"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spVolt2"
            android:layout_width="90dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Spinner
            android:id="@+id/spTimebase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spTimebase2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/connect" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/run" />

        <Button
            android:id="@+id/btnSingle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/single" />
    </LinearLayout>
</LinearLayout>
